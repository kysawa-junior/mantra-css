{
  "name": "@mantra/adapter-vite",
  "version": "1.0.0",
  "description": "Vite adapter for Mantra zero-runtime CSS extraction",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --out-dir dist",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantra/compiler": "workspace:*",
    "@mantra/swc-plugin": "workspace:*",
    "@mantra/core": "workspace:*"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
