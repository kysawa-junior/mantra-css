{
  "name": "@mantra/compiler",
  "version": "1.0.0",
  "description": "Mantra CSS compiler for build-time extraction",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --outDir dist",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantra/core": "workspace:*",
    "@mantra/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
